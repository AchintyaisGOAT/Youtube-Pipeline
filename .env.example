# Copy to .env and fill in (README §3.3). .env is git-ignored — never commit real values.

# --- LLMs (required) ---
# aistudio.google.com -> Get API key
GEMINI_API_KEY=
# console.groq.com -> API Keys
GROQ_API_KEY=

# --- Wikimedia (required) ---
# Must be a URL, not an email — Wikimedia's bot policy (tightened 2026-09-23) returns 403
# for any request whose User-Agent contact isn't a URL. Your channel or repo page works.
WIKIMEDIA_CONTACT=https://example.org/

# --- Images (optional) ---
# api.data.gov/signup — enables the Smithsonian Open Access image source.
SMITHSONIAN_API_KEY=

# --- Failure notifications (optional) ---
# A plain HTTPS URL that alerts are POSTed to, e.g. https://ntfy.sh/<a-hard-to-guess-topic>
# (subscribe to the same topic in the ntfy app). Leave blank to disable.
ALERT_URL=

# --- Paths (optional; defaults are under the repo) ---
# CONFIG_PATH=C:/path/to/config.yaml
# DATABASE_URL=sqlite:///C:/path/to/pipeline.db
# STORAGE_BASE=C:/path/to/data
# ASSETS_DIR=C:/path/to/assets
