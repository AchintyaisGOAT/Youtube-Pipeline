# Copy to .env and fill in. .env is git-ignored. See DESIGN.md section 3.6.

# --- Gemini (Google account #3) ---
GEMINI_API_KEY=

# --- YouTube (from client_secret.json + scripts/get_youtube_token.py; channel account) ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=

# --- Image sources ---
SMITHSONIAN_API_KEY=
# Wikimedia requires a real contact in the User-Agent or it returns 403.
WIKIMEDIA_CONTACT=yt-pipeline (you@example.com)

# --- Database (procrastinate shares this DB; no Redis) ---
# Alembic and procrastinate both read this one variable.
DATABASE_URL=postgresql+psycopg://ytpipe:CHANGE_ME@localhost:5432/ytpipe

# --- Storage root (single source of truth for all pipeline files) ---
# fsspec target. Plain path for local (Windows-safe); s3://bucket or b2://bucket later.
# Code derives work/, output/, cache/ UNDER this root. assets/ is separate (read-only input).
STORAGE_BASE=D:/Youtube_Pipeline/data
ASSETS_DIR=D:/Youtube_Pipeline/assets

# --- Failure notifications (apprise URL: ntfy / mailto / tgram) ---
ALERT_URL=ntfy://ntfy.sh/CHANGE_ME_private_topic
