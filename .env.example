# Copy to .env and fill in. .env is git-ignored. See INPUTS.md section F.

# --- Gemini (Google account #3) ---
GEMINI_API_KEY=

# --- YouTube (from client_secret.json + scripts/get_youtube_token.py; channel account) ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=

# --- Image sources ---
SMITHSONIAN_API_KEY=
WIKIMEDIA_CONTACT=yt-pipeline (you@example.com)

# --- Local infra (procrastinate shares this DB; no Redis) ---
DATABASE_URL=postgresql+psycopg://ytpipe:CHANGE_ME@localhost:5432/ytpipe

# --- Storage (fsspec URL — local now, s3:// / b2:// later, no code change) ---
STORAGE_BASE=file:///D:/Youtube_Pipeline/data

# --- Paths ---
ASSETS_DIR=D:/Youtube_Pipeline/assets
WORK_DIR=D:/Youtube_Pipeline/work
OUTPUT_DIR=D:/Youtube_Pipeline/output

# --- Failure notifications (apprise URL: ntfy / mailto / tgram) ---
ALERT_URL=ntfy://ntfy.sh/CHANGE_ME_private_topic
