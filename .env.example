# Copy to .env and fill in as you complete each step in DESIGN.md §3 / §4. .env is
# git-ignored — never commit real values.

# --- Gemini ---
# From a SECOND Google account (Cloud + Gemini), deliberately separate from the channel
# account (DESIGN.md #8). Get it at aistudio.google.com after creating a Cloud project.
GEMINI_API_KEY=

# --- YouTube (channel account) ---
# YOUTUBE_CLIENT_ID / YOUTUBE_CLIENT_SECRET come from client_secret.json:
#   Cloud Console -> Credentials -> OAuth client ID -> Desktop app
# YOUTUBE_REFRESH_TOKEN comes from running, once client_secret.json exists:
#   uv run python scripts/get_youtube_token.py client_secret.json
# YOUTUBE_CHANNEL_ID: Studio -> Settings -> Channel -> Advanced
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=

# --- Image sources ---
# Wikimedia requires a real contact in the User-Agent or it returns 403.
WIKIMEDIA_CONTACT=yt-pipeline (you@example.com)

# --- Database ---
# Optional. Defaults to a SQLite file at data/pipeline.db under the repo — only set this
# to put it somewhere else.
# DATABASE_URL=sqlite:///D:/Youtube_Pipeline/data/pipeline.db

# --- Storage root ---
# Optional. Defaults to data/ and assets/ under the repo — only set these to relocate
# them (e.g. a different drive).
# STORAGE_BASE=D:/Youtube_Pipeline/data
# ASSETS_DIR=D:/Youtube_Pipeline/assets

# --- Failure notifications ---
# A plain HTTPS URL that app/notify.py POSTs the alert text to (no apprise scheme).
# Easiest option, no signup: pick a private topic name and use
#   https://ntfy.sh/<a-random-hard-to-guess-topic-name>
# then subscribe to that same topic in the ntfy app/website to receive alerts.
# Leave blank to disable notifications.
ALERT_URL=
