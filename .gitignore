# ---- Secrets (never commit) ----
.env
.env.*
!.env.example
client_secret.json
token.json
*.pem
*.key

# ---- Data / media (large, regenerable) ----
data/
work/
output/
assets/music/
assets/sfx/
assets/branding/
assets/thumbnails/
assets/fonts/
