*.mp4
*.mov
*.wav
*.mp3
*.png
*.jpg
*.jpeg
!docs/**/*.png

# ---- Model weights / caches ----
models/
*.onnx
*.bin
*.ckpt
.cache/
huggingface/

# ---- Python ----
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
build/
dist/

# ---- Logs / DB dumps ----
logs/
*.log
*.dump
*.sql

# ---- OS / editor ----
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
