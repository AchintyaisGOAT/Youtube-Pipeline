# ---- Secrets (never commit) ----
.env
.env.*
!.env.example
client_secret.json
.claude
token.json
*.pem
*.key

# ---- Data / media / weights (large, regenerable) ----
data/
work/
output/
models/
# assets/: the audio files stay local, but each folder's manifest.yaml is committed —
# it holds every track's license and required credit, which must survive a new machine.
assets/**
!assets/*/
!assets/*/manifest.yaml
*.mp4
*.mov
*.wav
*.mp3
*.onnx
*.bin
*.ckpt
.cache/

# ---- Python ----
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
build/
dist/

# ---- Logs / DB dumps ----
*.log
*.dump
*.sql

# ---- OS / editor ----
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
